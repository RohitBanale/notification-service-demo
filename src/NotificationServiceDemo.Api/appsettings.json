{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=notification-demo.db" },
  "Dispatcher": { "Enabled": true, "PollIntervalSeconds": 2, "MaxAttempts": 3, "BaseDelaySeconds": 5, "BatchSize": 20 },
  "Summary": { "Enabled": true, "TimeUtc": "08:00", "Recipient": "ops@example.com", "Channel": "email" }
}
